          target="_blank"
          rel="noopener noreferrer">
          ➤ JOIN CHANNEL
        </a>

        <!-- JOIN VIP BUTTON: opens your Telegram bot -->
        <a
          class="btn vip"
          href="https://t.me/XAUUSDBUY1BOT"
          target="_blank"
          rel="noopener noreferrer">
          ★ JOIN VIP
        </a>

      </div>
    </section>

    <section class="section">
      <h2>What We Share</h2>

      <p>
        Gold market information and educational content
        to support your own market research.
      </p>

      <div class="cards">

        <div class="card">
          <div class="icon">📊</div>
          <h3>Market Analysis</h3>
          <p>
            XAUUSD chart observations and important
            market levels.
          </p>
        </div>

        <div class="card">
          <div class="icon">🎯</div>
          <h3>Trading Ideas</h3>
          <p>
            Gold trading setups and market ideas
            for your own review.
          </p>
        </div>

        <div class="card">
          <div class="icon">📘</div>
          <h3>Education</h3>
          <p>
            Learn about trading discipline,
            chart analysis and risk management.
          </p>
        </div>

      </div>
    </section>

  </main>

  <div class="risk">
    Risk Disclosure: Forex and CFD trading involve
    significant financial risk. Losses are possible.
    This website provides informational and educational
    content only, not financial advice. No profits
